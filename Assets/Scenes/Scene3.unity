    endingTextParts:
    - text: "FOMO is niet het probleem. Het probleem is wanneer je nergens meer \xE9cht
        bent. Je bent amper nog in het 'nu."
      displayDuration: 4
      fadeTime: 0.6
      revealLineByLine: 0
      fadeInEachLine: 1
      lineDelay: 0
      lineFadeTime: 0.35
      pauseAfter: 0.5
      keepOnScreen: 0
    - text: 'Hij wist wat er overal gebeurd was.

        Behalve waar hij zelf was.


        Hij
        las de berichten.


        Maar van zijn eigen avond bleef vooral over dat
        hij telkens even weg was.'
      displayDuration: 2.5
      fadeTime: 0.6
      revealLineByLine: 1
      fadeInEachLine: 1
      lineDelay: 0.75
      lineFadeTime: 0.35
      pauseAfter: 0.5
      keepOnScreen: 0
    - text: Hij was zo bang om iets te missen, dat het moment waarin hij zelf stond
        langzaam verloren ging.
      displayDuration: 4
      fadeTime: 0.6
      revealLineByLine: 0
      fadeInEachLine: 1
      lineDelay: 0
      lineFadeTime: 0.35
      pauseAfter: 0.5
      keepOnScreen: 0
    - text: Ben je blij met hoe je je aandacht hebt gespendeerd?
      displayDuration: 2
      fadeTime: 0.8
      revealLineByLine: 0
      fadeInEachLine: 1
      lineDelay: 0
      lineFadeTime: 0.35
